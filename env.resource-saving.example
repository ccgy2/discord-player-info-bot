# Optional Railway Variables. Preserve existing credentials and .env.
# v2: release OCR immediately after the queue empties; no message-content cache.
AUTOMOD_OCR_IDLE_SECONDS=0
AUTOMOD_OCR_EAGER=false
BOT_MESSAGE_CACHE=0
# Existing Railway Variables override Docker defaults: change old 15/100 values.
# OCR_IDLE_SECONDS=15 reduces cold starts for frequent images but holds RAM longer.
# -1 keeps OCR warm when idle; it still yields its slot to PDF/Excel work.
# PDF/OCR/Excel workers share one memory slot; never disable moderation to save RAM.
